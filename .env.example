# ---------------------------------------------------------------------------
# Agent Hotel — standalone configuration. Copy to .env and edit:
#     cp .env.example .env
# Used by setup_infra.sh / deploy_app.sh / verify_setup.sh.
# ---------------------------------------------------------------------------

# Google Cloud project id.
PROJECT_ID=your-gcp-project-id

# GKE cluster. Use a DISTINCT cluster name so you never touch an existing one.
# The hotel image tag defaults to this name, so two clusters can share one
# Artifact Registry repo without clobbering each other's images.
CLUSTER_NAME=agent-hotel

# Region / zone. REGION defaults to ZONE without its trailing -<letter>.
REGION=us-central1
ZONE=us-central1-a

# Default node pool: the Substrate control plane (api-server x2, PostgreSQL,
# router, egress gateway, credential provider, controller, PKI, atelet) and
# the concierge x2. Three e2-standard-4 nodes are enough; go to 4 if pods sit
# Pending. The ROOMS run on the compute class below by default; with
# USE_COMPUTE_CLASS=FALSE they run here too — then pick ONE CPU platform
# (e.g. c3-standard-4): a gVisor memory snapshot restores in full only on a
# CPU with the features it was taken on.
MACHINE_TYPE=e2-standard-4
NUM_NODES=3

# PostgreSQL (the api-server's store) volume. Upstream sizes it at 500Gi for
# activation load; a demo hotel needs a fraction of that.
# POSTGRES_STORAGE=20Gi

# Snapshot bucket (created if missing). Defaults to <PROJECT_ID>-substrate-snapshots.
# SNAPSHOT_BUCKET=my-substrate-snapshots

# Namespace the hotel deploys into.
NAMESPACE=default

# Artifact Registry repo for the hotel image (created if missing). The
# Substrate plane itself runs upstream's release images from ghcr.io.
ARTIFACT_REGISTRY_REPO=substrate-hotel

# Gemini. The guests call the Gemini API, but never hold the key: it lives in
# a Kubernetes Secret, and Substrate's egress gateway injects it into their
# HTTPS requests on the way out (nothing secret is ever in a sandbox or a
# snapshot). Set ONE of these; neither = scripted in-character replies (every
# Substrate mechanic still works).
#   GEMINI_API_KEY          — the key string
#   GEMINI_API_KEY_RESOURCE — a Google Cloud API key resource name
#                             (gcloud services api-keys list), resolved at deploy
# GEMINI_API_KEY=
# GEMINI_API_KEY_RESOURCE=projects/123456789/locations/global/keys/...
# GEMINI_MODEL=gemini-flash-latest   # an alias that tracks the current Flash model

# Optional: image tag. Defaults to CLUSTER_NAME so two clusters never share a
# :latest and clobber each other's golden snapshots.
# IMAGE_TAG=agent-hotel

# Hotel sizing. GUEST_COUNT personas are admitted at start (roster holds 20;
# more can be added from the UI at runtime). WORKER_REPLICAS is the initial
# number of rooms — also adjustable live from the UI (it patches the
# WorkerPool). Keep guests > rooms or there is no overcommit story to see.
GUEST_COUNT=12
WORKER_REPLICAS=3

# Node provisioning for the rooms. TRUE (default): Node Auto-Provisioning plus
# a Custom Compute Class (cluster/compute-class.yaml, c3-standard-4 only) —
# the WorkerPool's rooms get their own auto-provisioned nodes, so "+ Room" can
# grow the cluster itself. FALSE: rooms share the default node pool above.
# MAX_CPU/MAX_MEMORY cap what NAP may create.
USE_COMPUTE_CLASS=TRUE
MAX_CPU=100
MAX_MEMORY=400

# HTTP Basic auth for the hotel's public surface (UI + /api). deploy_app.sh
# writes these into the substrate-hotel-auth Secret, which the concierge
# reads as env — the password never passes through the rendered manifests.
# Leave HOTEL_PASSWORD unset/empty to run the hotel unauthenticated.
# NOTE: the gateway is plain HTTP, so credentials travel base64-encoded in
# cleartext — this keeps casual visitors out, it is not real security.
HOTEL_USERNAME=guest
# HOTEL_PASSWORD=choose-a-password

# Optional: seconds a guest lingers awake after its last reply before
# yielding its room. Reaches both the concierge (yield gating, sweeper) and
# the guests (via the ActorTemplate env).
# LINGER_SECONDS=10

# Optional: which guest verify_setup.sh runs its chat→sleep→wake proof with.
# GUEST=amara
