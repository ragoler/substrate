# ---------------------------------------------------------------------------
# Agent Hotel — standalone configuration. Copy to .env and edit:
#     cp .env.example .env
# Used by setup_infra.sh / deploy_app.sh / verify_setup.sh.
# ---------------------------------------------------------------------------

# Google Cloud project id.
PROJECT_ID=your-gcp-project-id

# GKE cluster. Use a DISTINCT cluster name so you never touch an existing one.
CLUSTER_NAME=agent-hotel-cluster

# Region / zone. REGION defaults to ZONE without its trailing -<letter>.
REGION=us-central1
ZONE=us-central1-a

# Default node pool. Three e2-standard-4 nodes comfortably host the ate
# control plane (api-server, valkey, router, controller, atelet), the
# 3-worker pool, and the concierge.
MACHINE_TYPE=e2-standard-4
NUM_NODES=3

# Namespace the hotel deploys into.
NAMESPACE=default

# Artifact Registry repo for the images (created by deploy_app.sh if missing).
# The prereq's `ko` build pushes ateom-gvisor here too — keep them the same.
ARTIFACT_REGISTRY_REPO=substrate-hotel

# Vertex AI (keyless, via ADC / Workload Identity). Set to FALSE to skip
# Gemini entirely — guests then answer with scripted in-character replies,
# which still demonstrates every Substrate mechanic.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Optional: image tag. Defaults to CLUSTER_NAME so two clusters never share a
# :latest and clobber each other's golden snapshots.
# IMAGE_TAG=agent-hotel-cluster

# Optional: seconds a guest lingers awake after its last reply before
# yielding its room (self-suspend).
# LINGER_SECONDS=10
